<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoSDK.JsonMetadata" Version="0.35.0-preview.2.102" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Label="CompilerMemory">
    <!-- Keep the compiler process isolated and retain every analyzer.
         Linux VM-reported memory varies, so use an explicit 15-GiB GC heap cap
         rather than a percentage. The complete x64 build and offline contracts
         passed in a 16-GiB container without swap. GC environment values are hex. -->
    <CscEnvironment Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(CscEnvironment);DOTNET_GCConserveMemory=9;DOTNET_GCHeapHardLimit=3C0000000</CscEnvironment>
    <CscEnvironment Condition="!$([MSBuild]::IsOSPlatform('Linux'))">$(CscEnvironment);DOTNET_GCConserveMemory=9;DOTNET_GCHeapHardLimitPercent=5A</CscEnvironment>
    <UseSharedCompilation>false</UseSharedCompilation>
    <CompilerResponseFile>$(MSBuildProjectDirectory)/compiler.rsp</CompilerResponseFile>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>Modern generated .NET SDK for the complete Apple App Store Connect API.</Description>
    <PackageTags>apple;app-store-connect;testflight;api;client;sdk;dotnet;openapi;generated;autosdk</PackageTags>
  </PropertyGroup>

</Project>

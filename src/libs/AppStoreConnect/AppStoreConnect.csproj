<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="CompilerMemory">
    <!-- The full Apple graph exceeds the default 75% container GC heap cap.
         Keep compiler GC tuning process-local and serialize compiler analysis;
         all analyzers remain enabled. Verified within 16 GiB, without swap.
         GC environment numbers are hexadecimal: 5A means 90 percent. -->
    <CscEnvironment>$(CscEnvironment);DOTNET_GCConserveMemory=9;DOTNET_GCHeapHardLimitPercent=5A</CscEnvironment>
    <UseSharedCompilation>false</UseSharedCompilation>
    <CompilerResponseFile>$(MSBuildProjectDirectory)/compiler.rsp</CompilerResponseFile>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>Modern generated .NET SDK for the complete Apple App Store Connect API.</Description>
    <PackageTags>apple;app-store-connect;testflight;api;client;sdk;dotnet;openapi;generated;autosdk</PackageTags>
  </PropertyGroup>

</Project>
